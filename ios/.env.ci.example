# CI/CD Environment Variables for TRIX 3D Companion iOS App
# Copy this to your CI/CD platform (GitHub Actions, GitLab CI, Jenkins, etc.)

# ============================================
# WARNING: SECURITY - READ CAREFULLY
# ============================================
#
# 1. NEVER set DEMO_* variables in production builds
# 2. ALWAYS use different credentials for staging and production
# 3. NEVER commit actual credentials to version control
# 4. Rotate credentials if they may have been exposed
# 5. Use secret management tools (Vault, AWS Secrets Manager, etc.)
#
# ============================================

# Production Environment Variables
# ============================================

# API Configuration
PRODUCTION_API_BASE_URL=https://api.trix3d.com
PRODUCTION_WEBSOCKET_URL=wss://api.trix3d.com

# WeChat Configuration (Production)
WECHAT_APP_ID_PRODUCTION=your_production_app_id
WECHAT_APP_SECRET_PRODUCTION=your_production_app_secret

# Security Settings
PRODUCTION_VALIDATE_SSL_CERTS=YES
PRODUCTION_DISABLE_DEBUGGING=YES

# Staging Environment Variables
# ============================================

STAGING_API_BASE_URL=https://staging-api.trix3d.com
STAGING_WEBSOCKET_URL=wss://staging-api.trix3d.com

# WeChat Configuration (Staging)
WECHAT_APP_ID_STAGING=your_staging_app_id
WECHAT_APP_SECRET_STAGING=your_staging_app_secret

# Demo Account (STAGING ONLY - NEVER IN PRODUCTION)
# ============================================
# These should ONLY be set in staging/dev environments
STAGING_DEMO_EMAIL=demo@trix3d.com
STAGING_DEMO_PASSWORD=demo123

# GitHub Actions Example
# ============================================
# Add these to your repository secrets:
# - WECHAT_APP_ID
# - WECHAT_APP_SECRET
# - DEMO_EMAIL (only for staging builds)
# - DEMO_PASSWORD (only for staging builds)

# GitLab CI Example
# ============================================
# Add these to your CI/CD variables (Settings > CI/CD > Variables):
# Key: WECHAT_APP_ID, Value: your_app_id, Protected: true
# Key: WECHAT_APP_SECRET, Value: your_secret, Protected: true, Masked: true

# Jenkins Example
# ============================================
# Use Credentials Binding Plugin:
# withCredentials([
#     string(credentialsId: 'wechat-app-id', variable: 'WECHAT_APP_ID'),
#     string(credentialsId: 'wechat-app-secret', variable: 'WECHAT_APP_SECRET')
# ]) {
#     sh 'make build'
# }
