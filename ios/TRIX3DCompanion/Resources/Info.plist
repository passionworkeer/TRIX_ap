<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TRIX 3D</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>wechat</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>TRIX 3D Companion uses the camera to capture study snapshots and scan QR codes for quick pairing with friends.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>TRIX 3D Companion uses Face ID for secure and convenient authentication to protect your account.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TRIX 3D Companion uses your location to show nearby study spots and share your location with friends when you choose to.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TRIX 3D Companion uses the microphone to record voice messages for sharing with your study partners.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TRIX 3D Companion needs permission to save your study snapshots and photos to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TRIX 3D Companion accesses your photo library to let you share photos with study partners and save snapshots.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>TRIX 3D Companion uses speech recognition to convert your voice messages into text for convenient chat input.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>TRIX_TEST_EMAIL</key>
	<string>$(TRIX_TEST_EMAIL)</string>
	<key>TRIX_TEST_PASSWORD</key>
	<string>$(TRIX_TEST_PASSWORD)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.trix3d.companion</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trix3dcompanion</string>
			</array>
		</dict>
	</array>
	<key>WECHAT_UNIVERSAL_LINK</key>
	<string>https://trix.love/wechat/</string>
	<key>SUPABASE_URL</key>
	<string>https://__SUPABASE_PROJECT_REF_REDACTED__.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>__SUPABASE_ANON_KEY_REDACTED__</string>
</dict>
</plist>
