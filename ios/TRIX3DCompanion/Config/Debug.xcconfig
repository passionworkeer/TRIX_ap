//
// Debug.xcconfig
// TRIX3DCompanion
//
// Debug configuration with opt-in local test credentials
//

// Build Settings
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
OTHER_SWIFT_FLAGS = $(inherited) -DDEBUG

// Local test credentials (DEBUG ONLY)
// Leave empty in source control. Inject explicitly via scheme/user settings when needed.
DEMO_EMAIL =
DEMO_PASSWORD =

// Example:
// xcodebuild -scheme TRIX3DCompanion DEMO_EMAIL=staging-demo@example.com DEMO_PASSWORD=change-me

// Network Configuration (Development)
SLASH = /
API_BASE_URL = http:$(SLASH)$(SLASH)localhost:3000
WEBSOCKET_URL = ws:$(SLASH)$(SLASH)localhost:3000

// Logging
ENABLE_VERBOSE_LOGGING = YES
