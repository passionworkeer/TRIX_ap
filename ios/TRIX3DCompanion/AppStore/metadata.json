    "subtitle": {
      "max_length": 30,
      "en": "Your 3D Printing Assistant",
      "zh-Hans": "您的 3D 打印助手",
      "note": "App 名称下方的副标题"
    },
    "description": {
      "max_length": 4000,
      "en": "TRIX 3D Companion is your ultimate assistant for 3D printing. Connect to your TRIX 3D printer wirelessly, monitor print progress in real-time, and control your printer from anywhere.\n\nKey Features:\n• Real-time print monitoring\n• Wireless printer control\n• Print job management\n• Temperature and status tracking\n• Camera preview support\n\nPerfect for makers, designers, and 3D printing enthusiasts who want to take control of their printing workflow.",
      "zh-Hans": "TRIX 3D 伴侣是您的 3D 打印终极助手。无线连接您的 TRIX 3D 打印机，实时监控打印进度，随时随地控制您的打印机。\n\n主要功能：\n• 实时打印监控\n• 无线打印机控制\n• 打印任务管理\n• 温度和状态跟踪\n• 摄像头预览支持\n\n非常适合创客、设计师和 3D 打印爱好者，掌控您的打印工作流程。",
      "note": "应用详细描述，支持 Markdown 格式"
    },
    "keywords": {
      "max_length": 100,
      "en": "3D printing,printer controller,TRIX,real-time monitor,wireless,maker,3D model",
      "zh-Hans": "3D打印,打印机控制,TRIX,实时监控,无线,创客,3D模型",
      "note": "逗号分隔的关键词，用于 App Store 搜索"
    },
    "what_new": {
      "max_length": 4000,
      "en": "Initial release:\n• Real-time print monitoring\n• Wireless printer control\n• Print job management\n• Temperature tracking\n• Camera preview",
      "zh-Hans": "首次发布：\n• 实时打印监控\n• 无线打印机控制\n• 打印任务管理\n• 温度跟踪\n• 摄像头预览",
      "note": "版本更新说明"
    },
    "promotional_text": {
      "max_length": 170,
      "en": "Control your TRIX 3D printer from anywhere. Monitor prints, adjust settings, and manage your workflow wirelessly.",
      "zh-Hans": "随时随地控制您的 TRIX 3D 打印机。监控打印、调整设置、无线管理您的工作流程。",
      "note": "App Store 顶部的宣传文本，可随时更新无需审核"
    },
