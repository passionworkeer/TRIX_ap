  "metadata": {
    "primary_language": "zh-Hans",
    "secondary_language": "en",
    "name": {
      "max_length": 30,
      "en": "TRIX 3D Companion",
      "zh-Hans": "TRIX 3D 伴侣",
      "note": "显示在主屏幕上的名称"
