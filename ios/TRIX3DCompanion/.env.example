# WeChat Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Do NOT commit .env file to version control - it's already in .gitignore

# WeChat App ID (can also be set in Info.plist)
WECHAT_APP_ID=YOUR_WECHAT_APP_ID

# WeChat App Secret (should ONLY be set via environment variable for security)
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET

# Demo Account (DEBUG builds only - NEVER set these in production!)
# These are used for local development and testing only
DEMO_EMAIL=demo@trix3d.com
DEMO_PASSWORD=demo123
