{
  "version": "1.0",
  "last_updated": "2026-02-27",
  "app_info": {
    "bundle_id": "com.trix3d.companion",
    "app_name": "TRIX 3D Companion",
    "team_id": "YOUR_TEAM_ID_HERE"
  },

  "environments": {
    "development": {
      "name": "Development (Sandbox)",
      "description": "For testing during development",
      "apns_server": "api.sandbox.push.apple.com",
      "apns_port": 443,
      "certificate_config": {
        "type": "certificate",
        "certificate_path": "/path/to/apns_dev.pem",
        "note": "Use .pem file generated from aps_development.cer",
        "expiration_check": "Certificates expire after 1 year - set calendar reminder"
      },
      "token_config": {
        "type": "token",
        "key_path": "/path/to/AuthKey_XXXXXXXXXX.p8",
        "key_id": "YOUR_KEY_ID_HERE",
        "team_id": "YOUR_TEAM_ID_HERE",
        "note": "Token-based authentication is preferred - no expiration"
      },
      "topic": "com.trix3d.companion",
      "push_type": "alert"
    },

    "production": {
      "name": "Production",
      "description": "For App Store distribution",
      "apns_server": "api.push.apple.com",
      "apns_port": 443,
      "certificate_config": {
        "type": "certificate",
        "certificate_path": "/path/to/apns_prod.pem",
        "note": "Use .pem file generated from aps_production.cer",
        "expiration_check": "Certificates expire after 1 year - set calendar reminder"
      },
      "token_config": {
        "type": "token",
        "key_path": "/path/to/AuthKey_XXXXXXXXXX.p8",
        "key_id": "YOUR_KEY_ID_HERE",
        "team_id": "YOUR_TEAM_ID_HERE",
        "note": "Token-based authentication is preferred - no expiration"
      },
      "topic": "com.trix3d.companion",
      "push_type": "alert"
    }
  },

  "notification_types": {
    "alert": {
      "description": "Standard alert notification",
      "apns_push_type": "alert",
      "priority": 10,
      "example_payload": {
        "aps": {
          "alert": {
            "title": "Notification Title",
            "body": "Notification body text",
            "sound": "default"
          },
          "badge": 1
        }
      }
    },

    "background": {
      "description": "Silent notification for background sync",
      "apns_push_type": "background",
      "priority": 5,
      "example_payload": {
        "aps": {
          "content-available": 1
        },
        "data": {
          "action": "sync_messages",
          "timestamp": "2026-02-27T12:00:00Z"
        }
      }
    },

    "voip": {
      "description": "VoIP notification for voice/video calls",
      "apns_push_type": "voip",
      "priority": 10,
      "note": "Requires special VoIP entitlement from Apple",
      "example_payload": {
        "aps": {
          "alert": {
            "title": "Incoming Call",
            "body": "Alice is calling"
          },
          "sound": "ringtone.caf"
        },
        "data": {
          "call_id": "call_123456",
          "caller_id": "user_alice",
          "call_type": "video"
        }
      }
    },

    "complication": {
      "description": "WatchOS complication update",
      "apns_push_type": "complication",
      "priority": 5,
      "note": "For Apple Watch complications - not used in current version"
    },

    "fileprovider": {
      "description": "File provider notification",
      "apns_push_type": "fileprovider",
      "priority": 5,
      "note": "For file provider extensions - not used in current version"
    },

    "location": {
      "description": "Location-triggered notification",
      "apns_push_type": "location",
      "priority": 10,
      "example_payload": {
        "aps": {
          "alert": {
            "title": "Nearby Study Spot",
            "body": "A friend is studying nearby"
          },
          "sound": "default"
        },
        "data": {
          "type": "location_share",
          "latitude": 39.9042,
          "longitude": 116.4074
        }
      }
    }
  },

  "payload_templates": {
    "new_message": {
      "description": "New message notification",
      "category": "MESSAGE",
      "payload": {
        "aps": {
          "alert": {
            "title": "New Message",
            "subtitle": "From ${sender_name}",
            "body": "${message_preview}"
          },
          "sound": "default",
          "badge": "${badge_count}",
          "thread-id": "${conversation_id}"
        },
        "data": {
          "type": "new_message",
          "message_id": "${message_id}",
          "conversation_id": "${conversation_id}",
          "sender_id": "${sender_id}",
          "timestamp": "${timestamp}"
        }
      }
    },

    "friend_request": {
      "description": "Friend request notification",
      "category": "FRIEND_REQUEST",
      "payload": {
        "aps": {
          "alert": {
            "title": "Friend Request",
            "body": "${user_name} wants to connect with you"
          },
          "sound": "default",
          "badge": "${badge_count}",
          "category": "FRIEND_REQUEST",
          "mutable-content": 1
        },
        "media-url": "${user_avatar_url}",
        "data": {
          "type": "friend_request",
          "request_id": "${request_id}",
          "user_id": "${user_id}",
          "user_name": "${user_name}"
        }
      }
    },

    "study_invitation": {
      "description": "Study group invitation",
      "category": "INVITATION",
      "payload": {
        "aps": {
          "alert": {
            "title": "Study Invitation",
            "subtitle": "From ${inviter_name}",
            "body": "You've been invited to join '${group_name}'"
          },
          "sound": "default",
          "badge": "${badge_count}",
          "category": "INVITATION",
          "mutable-content": 1
        },
        "media-url": "${group_image_url}",
        "data": {
          "type": "study_invitation",
          "group_id": "${group_id}",
          "group_name": "${group_name}",
          "inviter_id": "${inviter_id}",
          "inviter_name": "${inviter_name}"
        }
      }
    },

    "location_share": {
      "description": "Friend location share",
      "category": "LOCATION",
      "payload": {
        "aps": {
          "alert": {
            "title": "Friend Nearby",
            "body": "${user_name} is at ${location_name}"
          },
          "sound": "default",
          "badge": "${badge_count}"
        },
        "data": {
          "type": "location_share",
          "user_id": "${user_id}",
          "user_name": "${user_name}",
          "latitude": "${latitude}",
          "longitude": "${longitude}",
          "location_name": "${location_name}",
          "timestamp": "${timestamp}"
        }
      }
    },

    "study_reminder": {
      "description": "Study session reminder",
      "category": "REMINDER",
      "payload": {
        "aps": {
          "alert": {
            "title": "Study Reminder",
            "body": "Your study session '${session_name}' starts in 15 minutes"
          },
          "sound": "default",
          "badge": "${badge_count}"
        },
        "data": {
          "type": "study_reminder",
          "session_id": "${session_id}",
          "session_name": "${session_name}",
          "start_time": "${start_time}",
          "group_id": "${group_id}"
        }
      }
    },

    "achievement": {
      "description": "Achievement unlocked",
      "category": "ACHIEVEMENT",
      "payload": {
        "aps": {
          "alert": {
            "title": "Achievement Unlocked! 🎉",
            "body": "You've earned '${achievement_name}'"
          },
          "sound": "achievement.caf",
          "badge": "${badge_count}",
          "mutable-content": 1
        },
        "media-url": "${achievement_icon_url}",
        "data": {
          "type": "achievement",
          "achievement_id": "${achievement_id}",
          "achievement_name": "${achievement_name}",
          "achievement_description": "${achievement_description}",
          "points": "${points}"
        }
      }
    },

    "silent_sync": {
      "description": "Silent background sync",
      "category": null,
      "payload": {
        "aps": {
          "content-available": 1
        },
        "data": {
          "action": "sync_${sync_type}",
          "timestamp": "${timestamp}",
          "payload": "${additional_data}"
        }
      }
    }
  },

