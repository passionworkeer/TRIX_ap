  "backend_integration": {
    "library_recommendations": {
      "python": {
        "name": "apns2",
        "install": "pip install apns2",
        "github": "https://github.com/Pr0Ger/APNS2",
        "features": [
          "HTTP/2 support",
          "Token-based authentication",
          "Certificate-based authentication",
          "Batch sending",
          "Error handling"
        ]
      },

      "nodejs": {
        "name": "apn",
        "install": "npm install apn",
        "github": "https://github.com/node-apn/node-apn",
        "features": [
          "HTTP/2 support",
          "Token-based authentication",
          "Certificate-based authentication",
          "Queue management",
          "Error handling"
        ]
      },

      "java": {
        "name": "pushy",
        "install": "Maven: com.turo:pushy",
        "github": "https://github.com/jchambers/pushy",
        "features": [
          "HTTP/2 support",
          "Token-based authentication",
          "Certificate-based authentication",
          "Async sending",
          "Connection pooling"
        ]
      },

      "go": {
        "name": "apns2",
        "install": "go get github.com/sideshow/apns2",
        "github": "https://github.com/sideshow/apns2",
        "features": [
          "HTTP/2 support",
          "Token-based authentication",
          "Certificate-based authentication",
          "High performance",
          "Error handling"
        ]
      }
    },

    "api_endpoints": {
      "device_token_registration": {
        "endpoint": "POST /api/v1/devices/register",
        "request_body": {
          "device_token": "user_device_token_here",
          "platform": "ios",
          "app_version": "1.0.0",
          "os_version": "17.0"
        },
        "response": {
          "success": true,
          "message": "Device token registered successfully"
        }
      },

      "send_notification": {
        "endpoint": "POST /api/v1/notifications/send",
        "request_body": {
          "user_id": "target_user_id",
          "notification_type": "new_message",
          "payload_data": {
            "sender_name": "Alice",
            "message_preview": "Hey! Are you free to study?",
            "message_id": "msg_123456",
            "conversation_id": "conv_789"
          }
        },
        "response": {
          "success": true,
          "message_id": "notification_123456",
          "sent_at": "2026-02-27T12:00:00Z"
        }
      }
    }
  },

  "rate_limiting": {
    "description": "APNs rate limits and recommendations",
    "apns_limits": {
      "note": "Apple doesn't publish exact rate limits, but excessive sending may be throttled"
    },
    "recommendations": {
      "per_user": "Max 10-20 notifications per hour per user",
      "batch_sending": "Use batch APIs for multiple notifications",
      "cooldown": "Implement cooldown period for similar notifications",
      "prioritization": "Prioritize critical notifications over marketing"
    }
  },

  "security": {
    "certificate_storage": {
      "development": {
        "method": "Environment variable or local file",
        "path": "/path/to/certificates/apns_dev.pem",
        "note": "Never commit to version control - add to .gitignore"
      },
      "production": {
        "method": "Secret management system (AWS Secrets Manager, Azure Key Vault, HashiCorp Vault)",
        "note": "Use encrypted storage with access logging"
      }
    },

    "token_storage": {
      "method": "Secret management system",
      "note": "APNs .p8 keys should be stored securely and rotated if compromised"
    },

    "device_token_validation": {
      "format": "64 hexadecimal characters",
      "example": "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456",
      "validation_regex": "^[0-9a-fA-F]{64}$"
    },

    "data_privacy": {
      "pii_in_payload": "Avoid sending PII in notification payload",
      "encryption": "Consider encrypting sensitive data in notification payload",
      "user_consent": "Ensure users have opted-in to receive notifications"
    }
  },

  "monitoring": {
    "metrics": {
      "delivery": [
        "notifications_sent_total",
        "notifications_delivered_total",
        "notifications_failed_total",
        "delivery_latency_ms"
      ],
      "engagement": [
        "notification_open_rate",
        "action_button_tap_rate",
        "conversion_rate"
      ],
      "technical": [
        "device_tokens_registered",
        "device_tokens_invalidated",
        "certificate_expiration_days",
        "apns_response_time_ms"
      ]
    },

    "alerting": {
      "certificate_expiration": {
        "warning_days": 30,
        "critical_days": 7,
        "action": "Email DevOps team to rotate certificate"
      },
      "high_failure_rate": {
        "threshold": "> 10% failure rate in 5 minutes",
        "action": "Alert backend team"
      },
      "apns_unavailable": {
        "threshold": "> 5 consecutive connection failures",
        "action": "Check Apple System Status and alert team"
      }
    }
  },

  "testing": {
    "tools": [
      {
        "name": "Pusher",
        "platform": "macOS",
        "url": "https://github.com/noodlewerk/NWPusher",
        "features": "GUI-based testing, supports sandbox and production"
      },
      {
        "name": "Knuff",
        "platform": "macOS",
        "url": "https://github.com/KnuffApp/Knuff",
        "features": "Open-source, supports token and certificate auth"
      },
      {
        "name": "curl + HTTP/2",
        "platform": "Command line",
        "url": "https://curl.se/",
        "features": "Command-line testing, requires HTTP/2 support"
      }
    ],

    "test_scenarios": [
      "App in foreground - notification displayed",
      "App in background - notification displayed",
      "App terminated - notification displayed",
      "Tapping notification opens app",
      "Action button triggers correct action",
      "Badge count updates correctly",
      "Sound plays correctly",
      "Silent notification triggers background sync",
      "Rich notification displays media",
      "Notification grouping works correctly",
      "Critical alerts work (if entitled)"
    ]
  },

  "troubleshooting": {
    "common_issues": [
      {
        "issue": "Not receiving notifications",
        "causes": [
          "Wrong environment (sandbox vs production)",
          "Invalid or expired device token",
          "Invalid or expired certificate",
          "Firewall blocking APNs ports"
        ],
        "solution": "Check environment, verify certificate, test connectivity"
      },
      {
        "issue": "Device token not received",
        "causes": [
          "App not properly signed",
          "Using simulator instead of real device",
          "Network connectivity issues"
        ],
        "solution": "Use real device, check signing & capabilities"
      },
      {
        "issue": "Certificate errors",
        "causes": [
          "Certificate expired",
          "Wrong certificate format",
          "Private key passphrase issue"
        ],
        "solution": "Verify certificate expiration, regenerate if needed"
      },
      {
        "issue": "Silent notifications not working",
        "causes": [
          "UIBackgroundModes not configured",
          "App killed by system",
          "User disabled background app refresh"
        ],
        "solution": "Verify Info.plist, check device settings"
      }
    ]
  },

  "compliance": {
    "gdpr": {
      "requirements": [
        "Obtain explicit consent for notifications",
        "Allow easy opt-out",
        "Provide clear explanation of notification usage"
      ]
    },
    "ccpa": {
      "requirements": [
        "Honor 'Do Not Sell' requests",
        "Provide notification preferences in app"
      ]
    },
    "pipl": {
      "requirements": [
        "Store notification data on China servers if required",
        "Obtain consent for cross-border data transfer"
      ]
    },
    "app_store_review": {
      "requirements": [
        "Explain why notifications are needed",
        "Don't request on first launch",
        "Provide value to user",
        "Honor user preferences immediately"
      ]
    }
  },

  "notes": [
    "APNs certificates expire after 1 year - set calendar reminders",
    "Token-based authentication is preferred over certificates (no expiration)",
    "Always test on physical device (not simulator)",
    "Use sandbox environment for development, production for App Store",
    "Monitor certificate expiration and rotate proactively",
    "Never commit certificates to version control",
    "Implement proper error handling for APNs responses",
    "Respect user notification preferences and rate limits"
  ]
}
