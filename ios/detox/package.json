{
  "name": "trix-detox",
  "version": "1.0.0",
  "description": "Detox E2E tests for TRIX3DCompanion",
  "scripts": {
    "test": "detox test",
    "test:debug": "detox test --debug",
    "build": "detox build",
    "clean": "detox clean",
    "build:ios": "xcodebuild -project TRIX3DCompanion.xcodeproj -scheme TRIX3DCompanion -configuration Debug -destination 'generic/platform=iOS Simulator' build 2>&1 | tail -20",
    "test:ios": "detox test --configuration ios.sim.debug",
    "test:ios:ci": "detox test --configuration ios.sim.debug --record-logs all",
    "test:ios:device": "detox test --configuration ios.sim.debug --device-name \"${DETOX_DEVICE_NAME:-iPhone 17 Pro}\"",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "detox": "^20.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
