{
  "name": "trix-detox",
  "version": "1.0.0",
  "description": "Detox E2E tests for TRIX3DCompanion",
  "scripts": {
    "test": "detox test",
    "test:debug": "detox test --debug",
    "build": "detox build",
    "clean": "detox clean",
    "build:ios": "xcodebuild -workspace TRIX3DCompanion.xcworkspace -scheme TRIX3DCompanion -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 15 Pro' build 2>&1 | tail -20",
    "test:ios": "detox test --configuration ios.sim.debug",
    "test:ios:ci": "detox test --configuration ios.sim.debug --record-logs all",
    "test:iphone16": "detox test --configuration ios.sim.debug --device-name 'iPhone 16'",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "detox": "^20.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
