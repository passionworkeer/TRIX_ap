# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://__SUPABASE_PROJECT_REF_REDACTED__.supabase.co
VITE_SUPABASE_ANON_KEY=__SUPABASE_PUBLISHABLE_KEY_REDACTED__

# Clawdbot Gateway Configuration
# WebSocket connection to local Clawdbot Gateway
VITE_PC_WEBSOCKET_URL=ws://192.168.101.4:18789
VITE_PC_AUTH_TOKEN=__PC_AUTH_TOKEN_REDACTED__

# Example:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_PC_WEBSOCKET_URL=ws://192.168.1.100:18789
# VITE_PC_AUTH_TOKEN=__PC_AUTH_TOKEN_REDACTED__

