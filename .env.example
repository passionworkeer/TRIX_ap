# ============================================
# TRIX 3D Companion — Complete Environment Template
# ============================================
# 使用方式: cp .env.example .env，然后填入真实值
# 所有 .env* 文件（除 .env.example）已在 .gitignore 中，不会提交到 git
#
# Vite 加载规则:
#   dev:        .env + .env.local
#   production: .env + .env.production
# 所以 .env 放所有变量，dev/prod 模式不需要单独文件
# ============================================

# ============================================
# Supabase（Web / iOS / Desktop 通用）
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Desktop main process（Electron ipc.ts 用，同一组凭证）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# TRIX Native Server（Web / iOS / Desktop 通用）
# ============================================
VITE_TRIX_NATIVE_SERVER_URL=http://localhost:8788
VITE_TRIX_NATIVE_PUBLIC_URL=http://localhost:8788

# ============================================
# Legacy Clawbot Endpoints（可选兼容路径，仅本地调试用）
# ============================================
# VITE_CLAWBOT_CHANNEL_URL=ws://localhost:8765
# VITE_GATEWAY_WS_URL=ws://localhost:18789
# VITE_GATEWAY_AUTH_TOKEN=replace-with-your-gateway-token

# ============================================
# TTS Proxy
# ============================================
VITE_TTS_PROXY_URL=https://trix.love

# ============================================
# Chat Media Upload Strategy
# ============================================
VITE_USE_SERVER_OSS_UPLOAD=true

# ============================================
# Baidu Maps
# ============================================
# 申请地址: https://lbsyun.baidu.com/
VITE_BAIDU_MAP_AK=your-baidu-map-api-key

# ============================================
# Log Level（dev: debug | prod: error）
# ============================================
VITE_LOG_LEVEL=debug

# ============================================
# Doubao TTS（服务端专用，Vite 不会暴露到前端）
# ============================================
DOUBAO_TTS_ENABLED=true
DOUBAO_TTS_APP_ID=your-doubao-app-id
DOUBAO_TTS_TOKEN=your-doubao-token
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE_TYPE=BV002_streaming
DOUBAO_TTS_RATE=24000
DOUBAO_TTS_SPEED_RATIO=1.0
DOUBAO_TTS_VOLUME_RATIO=1.0
DOUBAO_TTS_TIMEOUT_MS=12000
DOUBAO_TTS_MAX_TEXT_LENGTH=500
DOUBAO_TTS_CACHE_TTL_MS=300000
DOUBAO_TTS_CACHE_MAX_ITEMS=100

# ============================================
# Aliyun OSS（服务端 + 旧版前端直传）
# ============================================
VITE_ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
VITE_ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
VITE_ALIYUN_OSS_REGION=oss-cn-shenzhen
VITE_ALIYUN_OSS_BUCKET=your-bucket-name
VITE_ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com

# Node.js 服务端用（Electron main / clawbot-channel 等）
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OSS_REGION=oss-cn-shenzhen
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com

# ============================================
# Server Configuration（clawbot-channel 服务端用）
# ============================================
NODE_ENV=development
SERVER_PORT=8765
SERVER_HOST=0.0.0.0
CORS_ORIGINS=
DATABASE_PATH=./server/clawbot-channel/data/pairing.db
PAIRING_CODE_EXPIRY=300000
PAIRING_TOKEN_EXPIRY=600000
CLAWBOT_WEBHOOK_SECRET=your-webhook-secret-here
ENABLE_STUDY_ROOM_SOCKET=true
STUDY_ROOM_MAX_MEMBERS=5
STUDY_ROOM_CODE_LENGTH=6
