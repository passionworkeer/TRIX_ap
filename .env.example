# ============================================
# 🔑 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入你的实际值

# ============================================
# 📦 Supabase 数据库配置
# ============================================
# 🔍 如何获取 Supabase 密钥：
# 
# 步骤 1：访问你的 Supabase 项目设置页面
#   https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
#   
# 步骤 2：在 "Project URL" 部分，复制 URL
#   示例：https://__SUPABASE_PROJECT_REF_REDACTED__.supabase.co
#   
# 步骤 3：在 "Project API keys" 部分，找到 "anon public" 密钥
#   ⚠️ 这是一个很长的 JWT token，以 "eyJ" 开头
#   ⚠️ 不要使用 "sb_publishable_" 开头的密钥（那是错误的格式）
#   示例：eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ...
#
# 🚨 重要提示：
#   - anon key（匿名公钥）：可以在前端使用，用于客户端访问
#   - service_role key（服务角色密钥）：只能在后端使用，不要放在前端！
#   - JWT secret（JWT 密钥）：不需要在前端使用

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxMjM0NTY3ODkwLCJleHAiOjEyMzQ1Njc4OTB9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# 🤖 Clawbot Gateway 配置
# ============================================
# WebSocket connection to Clawdbot Gateway
#
# 选择连接模式：
# 1. Tailscale 内网模式（推荐，更稳定）
# 2. ngrok 公网模式（需要 ngrok 运行）
# 3. 局域网模式（仅限同网络）
#
# ============================================

# 推荐：统一使用 Gateway 变量（Diagnostic / TokenMonitor / GatewayAPI）
VITE_GATEWAY_WS_URL=ws://TAILSCALE_HOST:18789
VITE_GATEWAY_AUTH_TOKEN=__PC_AUTH_TOKEN_REDACTED__

# 兼容旧变量名（保留，建议与上面保持一致）
# Tailscale 内网模式（推荐）
# 获取 Tailscale IP: 运行 `tailscale ip`
VITE_PC_WEBSOCKET_URL=ws://TAILSCALE_HOST:18789
VITE_PC_AUTH_TOKEN=__PC_AUTH_TOKEN_REDACTED__

# 或者使用 ngrok 公网模式（备用）
# VITE_PC_WEBSOCKET_URL=wss://devyn-physicochemical-halina.ngrok-free.dev
# VITE_PC_AUTH_TOKEN=__PC_AUTH_TOKEN_REDACTED__

# 或者使用局域网模式（本地开发）
# VITE_PC_WEBSOCKET_URL=ws://192.168.1.100:18789
# VITE_PC_AUTH_TOKEN=__PC_AUTH_TOKEN_REDACTED__

# OSS 文件上传端点（用于图片/视频上传）
VITE_OSS_ENDPOINT=https://your-oss-endpoint.com/upload

