# ============================================
# TRIX 3D Companion - Environment Template
# ============================================
# Copy this file to .env for local development.
# Production can use either:
# - VITE_TRIX_NATIVE_SERVER_URL (recommended)
# - or the legacy trio VITE_CLAWBOT_CHANNEL_URL / VITE_GATEWAY_WS_URL / VITE_GATEWAY_AUTH_TOKEN

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Recommended native channel endpoints
VITE_TRIX_NATIVE_SERVER_URL=http://localhost:8788
VITE_TRIX_NATIVE_PUBLIC_URL=http://localhost:8788

# Legacy Clawbot endpoints (optional compatibility path)
VITE_CLAWBOT_CHANNEL_URL=ws://localhost:8765
VITE_GATEWAY_WS_URL=ws://localhost:18789
VITE_GATEWAY_AUTH_TOKEN=replace-with-your-gateway-token

# Legacy compatibility variable names (optional)
# VITE_CLAWBOT_GATEWAY_URL=ws://localhost:18789
# VITE_CLAWBOT_GATEWAY_TOKEN=replace-with-your-gateway-token
# VITE_PC_WEBSOCKET_URL=ws://localhost:18789
# VITE_PC_AUTH_TOKEN=replace-with-your-gateway-token

# ============================================
# Application Configuration
# ============================================

# Log Level (debug | info | warn | error)
VITE_LOG_LEVEL=debug

# Remote Logging (optional)
# VITE_ENABLE_REMOTE_LOGGING=true
# VITE_REMOTE_LOG_ENDPOINT=https://your-log-endpoint.com/logs

# Chat media upload strategy
VITE_USE_SERVER_OSS_UPLOAD=true

# Aliyun OSS (browser direct upload; legacy fallback path)
VITE_ALIYUN_OSS_REGION=oss-cn-hangzhou
VITE_ALIYUN_OSS_BUCKET=your-bucket-name
VITE_ALIYUN_OSS_ACCESS_KEY_ID=your-access-key
VITE_ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-secret
VITE_ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Deprecated legacy endpoint variable (still supported in dev fallback logic)
# VITE_OSS_ENDPOINT=http://localhost:8765/upload

# Optional: dedicated TTS proxy URL
# VITE_TTS_PROXY_URL=http://localhost:8765

# ============================================
# Server Configuration (server/clawbot-channel)
# ============================================
NODE_ENV=production
SERVER_PORT=8765
SERVER_HOST=0.0.0.0

# CORS whitelist (comma-separated domains)
CORS_ORIGINS=

# Database
DATABASE_PATH=./server/clawbot-channel/data/pairing.db

# Pairing Configuration
PAIRING_CODE_EXPIRY=300000
PAIRING_TOKEN_EXPIRY=600000

# Clawbot Webhook Secret
CLAWBOT_WEBHOOK_SECRET=your-webhook-secret-here

# Study room realtime
ENABLE_STUDY_ROOM_SOCKET=true
STUDY_ROOM_MAX_MEMBERS=5
STUDY_ROOM_CODE_LENGTH=6
