# ============================================
# TRIX 3D Companion - Environment Template
# ============================================
# Copy this file to .env for local development.
# In production, the following vars are REQUIRED and must not use localhost/127.0.0.1:
# - VITE_CLAWBOT_CHANNEL_URL
# - VITE_GATEWAY_WS_URL
# - VITE_GATEWAY_AUTH_TOKEN

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical Clawbot endpoints (recommended)
VITE_CLAWBOT_CHANNEL_URL=ws://localhost:8765
VITE_GATEWAY_WS_URL=ws://localhost:18789
VITE_GATEWAY_AUTH_TOKEN=replace-with-your-gateway-token

# Legacy compatibility variable names (optional)
# VITE_CLAWBOT_GATEWAY_URL=ws://localhost:18789
# VITE_CLAWBOT_GATEWAY_TOKEN=replace-with-your-gateway-token
# VITE_PC_WEBSOCKET_URL=ws://localhost:18789
# VITE_PC_AUTH_TOKEN=replace-with-your-gateway-token

# OSS upload endpoint
VITE_OSS_ENDPOINT=https://your-oss-endpoint.com/upload

# Optional: dedicated TTS proxy URL (useful in local debug when channel points to remote)
# VITE_TTS_PROXY_URL=http://localhost:8765

# ============================================
# Server Configuration (server/clawbot-channel)
# ============================================
NODE_ENV=production
SERVER_PORT=8765
SERVER_HOST=0.0.0.0

# Database
DATABASE_PATH=./server/clawbot-channel/data/pairing.db

# Pairing Configuration
PAIRING_CODE_EXPIRY=300000      # Pairing code expiry: 5 minutes
PAIRING_TOKEN_EXPIRY=600000     # Pairing token expiry: 10 minutes

# Clawbot Webhook Secret (for callback verification)
CLAWBOT_WEBHOOK_SECRET=your-webhook-secret-here

# Alibaba Cloud OSS (for server-side file upload)
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key
OSS_ACCESS_KEY_SECRET=your-access-secret

# Doubao TTS (server-side proxy)
DOUBAO_TTS_ENABLED=true
DOUBAO_TTS_APP_ID=your-doubao-app-id
DOUBAO_TTS_TOKEN=your-doubao-token
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE_TYPE=BV002_streaming
DOUBAO_TTS_RATE=24000
DOUBAO_TTS_SPEED_RATIO=1.0
DOUBAO_TTS_VOLUME_RATIO=1.0
DOUBAO_TTS_TIMEOUT_MS=12000
DOUBAO_TTS_MAX_TEXT_LENGTH=500
DOUBAO_TTS_CACHE_TTL_MS=300000
DOUBAO_TTS_CACHE_MAX_ITEMS=100
