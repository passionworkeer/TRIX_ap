# ============================================
# TRIX 3D Companion - Environment Template
# ============================================
# Copy this file to .env for local development.
# In production, the following vars are REQUIRED and must not use localhost/127.0.0.1:
# - VITE_CLAWBOT_CHANNEL_URL
# - VITE_GATEWAY_WS_URL
# - VITE_GATEWAY_AUTH_TOKEN

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical Clawbot endpoints (recommended)
VITE_CLAWBOT_CHANNEL_URL=ws://localhost:8765
VITE_GATEWAY_WS_URL=ws://localhost:18789
VITE_GATEWAY_AUTH_TOKEN=replace-with-your-gateway-token

# Legacy compatibility variable names (optional)
# VITE_CLAWBOT_GATEWAY_URL=ws://localhost:18789
# VITE_CLAWBOT_GATEWAY_TOKEN=replace-with-your-gateway-token
# VITE_PC_WEBSOCKET_URL=ws://localhost:18789
# VITE_PC_AUTH_TOKEN=replace-with-your-gateway-token

# OSS upload endpoint
VITE_OSS_ENDPOINT=https://your-oss-endpoint.com/upload
