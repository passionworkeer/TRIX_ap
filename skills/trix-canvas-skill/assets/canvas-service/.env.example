CANVAS_HOST=127.0.0.1
CANVAS_PORT=8789
CANVAS_BASE_URL=http://127.0.0.1:8789
CANVAS_DATA_DIR=./data
CANVAS_EXPORT_DIR=./exports
CANVAS_JSON_LIMIT=50mb
CANVAS_AI_REQUEST_TIMEOUT_MS=60000
CANVAS_REMOTE_FETCH_TIMEOUT_MS=30000
CANVAS_MAX_UPLOAD_BYTES=209715200
CANVAS_MAX_REMOTE_DOWNLOAD_BYTES=209715200
CANVAS_ALLOW_PRIVATE_REMOTE_URLS=false
CANVAS_REQUIRE_AUTH=false
CANVAS_ACCESS_TOKEN=
CANVAS_AUTH_TOKEN_FILE=./data/.canvas-access-token
CANVAS_ALLOWED_ORIGINS=
CANVAS_ALLOW_INSECURE_PUBLIC=false

# Backend AI provider (required when running /api/session)
AI_API_BASE=https://your-ai-provider.example.com
AI_API_KEY=sk-your-ai-key
AI_GENERATE_PATH=/generate
AI_TASK_PATH_TEMPLATE=/tasks/:taskId
# Optional headers to forward to AI vendor (one per line)
AI_EXTRA_HEADERS=Organization: your-team

# Proxy settings (used by start-all.js / proxy.js)
PROXY_PORT=8790
PROXY_HOST=127.0.0.1
PROXY_ALLOWED_ORIGINS=
PROXY_ALLOW_REMOTE=false
PROXY_ACCESS_TOKEN=
PROXY_MAX_BODY_BYTES=262144
PROXY_REQUEST_TIMEOUT_MS=120000
PROXY_TASK_TTL_MS=3600000
PROXY_SESSION_TTL_MS=3600000

# AI API (apiyi — set AI_API_BASE and AI_API_KEY)
AI_API_BASE=https://api.apiyi.com
AI_API_KEY=sk-your-apiyi-key
AI_GENERATE_PATH=/anthropic/v1/messages
AI_IMAGE_MODEL=gemini-3.1-flash-image-preview
AI_VIDEO_MODEL=veo-3.1
AI_VIDEO_PATH=/v1/video/generations
AI_VIDEO_TASK_PATH_TEMPLATE=/v1/video/generations/{taskId}

# Relay settings (optional, used when you want a sidecar to adapt vendor APIs)
RELAY_PORT=8791
RELAY_HOST=127.0.0.1
RELAY_ALLOWED_ORIGINS=
RELAY_ALLOW_REMOTE=false
RELAY_ACCESS_TOKEN=
RELAY_MAX_BODY_BYTES=262144
RELAY_REQUEST_TIMEOUT_MS=120000
RELAY_TASK_TTL_MS=3600000
IMAGE_API_URL=https://your-image-api.example.com/generate
IMAGE_API_METHOD=POST
IMAGE_API_KEY=sk-your-image-key
IMAGE_API_MODEL=image-01
VIDEO_API_URL=https://your-video-api.example.com/tasks
VIDEO_API_METHOD=POST
VIDEO_API_KEY=sk-your-video-key
VIDEO_API_MODEL=veo-3.1-fast

# The relay can also expose generated assets if the vendor returns base64.
RELAY_OUTPUT_PREFIX=http://127.0.0.1:8791/outputs
