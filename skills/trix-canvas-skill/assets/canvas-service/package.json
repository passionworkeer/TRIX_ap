{
  "name": "trix-canvas-service",
  "version": "1.0.0",
  "description": "TRIX Canvas - AI 生成结果展示服务",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "proxy": "node proxy.js",
    "start:all": "node start-all.js",
    "sync:skill-runtime": "python3 ../../skills/trix-canvas-skill/scripts/sync_canvas_runtime.py",
    "test:smoke": "node --test ../../tests/smoke/trix-canvas-smoke.test.mjs",
    "check": "node --check server.js && node --check proxy.js && node --check relay.js && node --check start-all.js",
    "rebuild": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "path-to-regexp": "0.1.13",
    "uuid": "^9.0.1"
  }
}
