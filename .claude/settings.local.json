{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "*"
    ],
    "additionalDirectories": [
      "e:\\desktop\\trix-3d-companion",
      "e:\\desktop\\openclaw-token-monitor",
      "C:\\Users\\wang\\.openclaw\\skills\\pairing",
      "C:\\Users\\wang\\.openclaw",
      "e:\\desktop\\nanobot",
      "C:\\Users\\wang\\AppData\\Local\\Programs",
      "C:\\Users\\wang\\.ssh",
      "D:\\miniconda",
      "C:\\nodejs_global"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-lint-pass.sh",
            "statusMessage": "Running lint check...",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash(git commit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-tests-pass.sh",
            "statusMessage": "Running tests before commit...",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "git push",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-build-pass.sh",
            "statusMessage": "Running build check before push...",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git push",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/smoke-test.sh",
            "statusMessage": "Running deployment smoke test...",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
