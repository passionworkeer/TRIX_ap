{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "NotebookEdit(*)",
      "AskUserQuestion(*)",
      "Skill(*)",
      "Task(*)",
      "TodoWrite(*)",
      "EnterPlanMode(*)",
      "ExitPlanMode(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "mcp__4_5v_mcp__*",
      "mcp__web_reader__*"
    ],
    "additionalDirectories": [
      "e:\\desktop\\trix-3d-companion",
      "e:\\desktop\\openclaw-token-monitor",
      "C:\\Users\\wang\\.openclaw\\skills\\pairing",
      "C:\\Users\\wang\\.openclaw",
      "e:\\desktop\\nanobot"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-lint-pass.sh",
            "statusMessage": "Running lint check..."
          }
        ]
      },
      {
        "matcher": "Bash(git commit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-tests-pass.sh",
            "statusMessage": "Running tests before commit..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "git push",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-build-pass.sh && bash .claude/hooks/check-e2e-pass.sh",
            "statusMessage": "Running build and E2E tests before push..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git push",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/smoke-test.sh",
            "statusMessage": "Running deployment smoke test...",
            "async": true
          }
        ]
      }
    ]
  }
}
