{
  "name": "@trix-app/trix-native-plugin",
  "version": "1.0.0",
  "description": "TRIX Native Channel Plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "channel": {
      "id": "trix-native",
      "label": "TRIX Native",
      "selectionLabel": "TRIX Native (手机配对)",
      "aliases": ["trix", "native", "phone"]
    },
    "install": {
      "npmSpec": "@trix-app/trix-native-plugin"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
