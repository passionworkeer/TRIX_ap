{
  "name": "trix-companion-desktop",
  "version": "1.0.0",
  "description": "TRIX Companion Windows Desktop App",
  "main": "dist-desktop/main/index.cjs",
  "author": "TRIX Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0"
  },
  "scripts": {
    "dev:desktop": "vite --config vite.config.desktop.ts",
    "build:desktop": "vite build --config vite.config.desktop.ts",
    "build:desktop:dir": "npm run build:desktop && electron-builder --config electron-builder.yml --dir",
    "build:desktop:pkg": "npm run build:desktop && electron-builder --config electron-builder.yml",
    "start": "electron ."
  }
}