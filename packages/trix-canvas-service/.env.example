# ============================================================
# TRIX Canvas Service - 配置文件
# ============================================================
# 使用前请复制为 .env 并填入实际值
# cp .env.example .env

# ---------- AI 生成服务 ----------
# 你的生图/视频 API 的基础地址（末尾不要加斜杠）
# 示例: https://api.example.com/v1
AI_API_BASE=

# AI 服务鉴权 Token（Bearer Token）
AI_API_KEY=

# AI 服务额外 Header（选填，用于特殊鉴权场景）
# 格式: Header-Name:Value，多个用换行分隔
AI_EXTRA_HEADERS=

# ---------- 文件上传 ----------
# OSS 上传地址（用于上传参考图/视频到 CDN）
# 示例: https://upload.example.com/api/upload
UPLOAD_API_URL=

# OSS 鉴权 Token（可选）
UPLOAD_API_KEY=

# ---------- Canvas 本地服务 ----------
# Canvas 服务监听端口（服务器上建议 8789）
CANVAS_PORT=8789

# Canvas 数据目录（存放 project/session JSON）
CANVAS_DATA_DIR=./data

# Canvas 输出目录（存放生成的图片/视频文件）
CANVAS_OUTPUT_DIR=./outputs

# Canvas 访问基础 URL（末尾不要加斜杠，用于生成画布链接）
# 生产环境用你的公网地址
# 示例: http://TRIX_SERVER_HOST:8789
CANVAS_BASE_URL=http://localhost:8789
