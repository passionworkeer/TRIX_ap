TRIX_NATIVE_SERVICE_TOKEN=replace-with-strong-service-token
TRIX_NATIVE_ADMIN_TOKEN=replace-with-strong-admin-token
TRIX_NATIVE_ATTACHMENT_SIGNING_SECRET=replace-with-strong-signing-secret
# Optional: restrict service-token endpoints to fixed source IPs or CIDRs.
# Leave empty when the Gateway host has a dynamic residential IP.
TRIX_NATIVE_SERVICE_ALLOWLIST=
TRIX_NATIVE_RATE_LIMIT_CLAIM_MAX=10
TRIX_NATIVE_RATE_LIMIT_CLAIM_WINDOW_MS=60000
TRIX_NATIVE_RATE_LIMIT_USER_MESSAGES_MAX=120
TRIX_NATIVE_RATE_LIMIT_USER_MESSAGES_WINDOW_MS=60000
TRIX_NATIVE_RATE_LIMIT_USER_UPLOADS_MAX=30
TRIX_NATIVE_RATE_LIMIT_USER_UPLOADS_WINDOW_MS=60000
TRIX_NATIVE_RATE_LIMIT_SERVICE_MESSAGES_MAX=240
TRIX_NATIVE_RATE_LIMIT_SERVICE_MESSAGES_WINDOW_MS=60000
TRIX_NATIVE_RATE_LIMIT_SERVICE_UPLOADS_MAX=120
TRIX_NATIVE_RATE_LIMIT_SERVICE_UPLOADS_WINDOW_MS=60000
