<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.profile-backup</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__REPO_ROOT__/packages/trix-openclaw-native/ops/scripts/backup-openclaw-profile.sh</string>
      <string>__HOME__/.openclaw</string>
      <string>__HOME__/.openclaw-backups</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>RETENTION_DAYS</key>
      <string>14</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>27</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.openclaw/logs/profile-backup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.openclaw/logs/profile-backup.err.log</string>
  </dict>
</plist>
