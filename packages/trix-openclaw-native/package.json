{
  "name": "@trix-app/openclaw-native-channel",
  "version": "0.1.0",
  "description": "TRIX native OpenClaw multimodal channel with pairing, QR onboarding, LAN relay, and persistent conversations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trix-openclaw-native": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./setup-entry": {
      "import": "./dist/setup-entry.js",
      "types": "./dist/setup-entry.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openclaw",
    "trix",
    "pairing",
    "qr",
    "multimodal",
    "websocket"
  ],
  "author": "TRIX Team",
  "license": "MIT",
  "dependencies": {
    "@trix-app/relay-client": "file:../trix-relay-client",
    "qrcode": "^1.5.4",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.8"
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "trix-native",
      "label": "TRIX Native",
      "selectionLabel": "Trix Native",
      "docsPath": "/channels/trix-native",
      "docsLabel": "trix-native",
      "blurb": "TRIX IM native channel",
      "aliases": ["trix"]
    },
    "install": {
      "npmSpec": "@trix-app/openclaw-native-channel",
      "localPath": "extensions/trix-native",
      "defaultChoice": "npm"
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.2",
    "vitest": "^1.3.1"
  }
}
