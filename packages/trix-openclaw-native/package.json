{
  "name": "@wangjianjun0531/trix-native",
  "version": "0.1.0",
  "description": "TRIX Service-backed OpenClaw native channel plugin with pairing, QR onboarding, and persistent conversations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trix-openclaw-native": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./setup-entry": {
      "import": "./dist/setup-entry.js",
      "types": "./dist/setup-entry.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist",
    "ops",
    "openclaw.plugin.json"
  ],
  "keywords": [
    "openclaw",
    "trix",
    "pairing",
    "qr",
    "multimodal",
    "websocket"
  ],
  "author": "TRIX Team",
  "license": "MIT",
  "dependencies": {
    "node-edge-tts": "^1.2.10",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.28 <2027"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "trix-native",
      "label": "TRIX Native",
      "selectionLabel": "Trix Native",
      "docsPath": "/channels/trix-native",
      "docsLabel": "trix-native",
      "blurb": "TRIX service-backed native channel plugin",
      "aliases": [
        "trix"
      ]
    },
    "install": {
      "npmSpec": "@wangjianjun0531/trix-native",
      "localPath": "extensions/trix-native",
      "defaultChoice": "npm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.8.2",
    "vitest": "^1.3.1"
  }
}
