{
  "name": "trix-3d-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "npm run test:unit && npm run test:smoke && npm run test:server",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "test:server": "npm --prefix server/clawbot-channel test",
    "test:server:extended": "npm --prefix server/clawbot-channel test -- tests/*.test.js",
    "test:api": "TEST_SERVER_URL=http://localhost:8765 npm --prefix server/clawbot-channel test -- tests/api-integration.test.js",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "node desktop-e2e.cjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:smoke && npm run test:e2e",
    "dev:desktop": "cd desktop && npm run dev:desktop",
    "dev:desktop:watch": "cd desktop && npm run dev:desktop:watch",
    "start:desktop": "cd desktop && npm run start",
    "build:desktop": "cd desktop && npm run build:desktop",
    "build:desktop:dir": "cd desktop && npm run build:desktop:dir"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.94.0",
    "ali-oss": "^6.23.0",
    "browser-image-compression": "^2.0.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.33.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.8.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.183.2",
    "ws": "^8.19.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^1.3.1",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.3.1",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.7.0",
    "http-proxy": "^1.18.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^1.3.1"
  }
}
