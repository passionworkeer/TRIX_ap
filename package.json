{
  "name": "trix-3d-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix packages/trix-web-api run dev",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "npm --prefix packages/trix-web-api run start",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src eslint.config.js --ext js,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src eslint.config.js --ext js,ts,tsx --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:smoke && npm run test:server",
    "test:run": "vitest run",
    "test:unit": "npm run test:unit:components && npm run test:unit:services && npm run test:unit:app && npm run test:unit:screens:core && npm run test:unit:screens:aux",
    "test:unit:components": "vitest run src/components --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:unit:services": "vitest run src/services src/lib --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:unit:app": "vitest run src/hooks src/utils src/contexts tests/integration --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:unit:screens:core": "vitest run src/screens/Auth.test.tsx src/screens/Chat.test.tsx src/screens/Study.test.tsx src/screens/Profile.test.tsx src/screens/Wardrobe.test.tsx --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:unit:screens:aux": "vitest run src/screens/Pairing.test.tsx src/screens/Diagnostic.test.tsx src/screens/QRCodePairing.test.tsx src/screens/Snapshot.test.tsx src/screens/PointsMall.test.tsx src/screens/Home.test.tsx src/screens/DiagnosticAdvanced.test.tsx src/screens/SnapMapScreen.test.tsx --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "test:server": "npm --prefix packages/trix-openclaw-native run test",
    "test:server:extended": "npm --prefix packages/trix-openclaw-native run test",
    "test:api": "npm --prefix packages/trix-openclaw-native run test",
    "test:web-api": "npm --prefix packages/trix-web-api run test",
    "test:e2e": "playwright test",
    "test:e2e:canvas": "playwright test tests/e2e/canvas.spec.ts --config tests/e2e/playwright-canvas.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:pwa:prod-smoke": "node scripts/pwa_native_prod_smoke.mjs",
    "test:all": "npm run test:unit && npm run test:smoke && npm run test:e2e",
    "dev:desktop": "cd desktop && npm run dev:desktop",
    "dev:desktop:watch": "cd desktop && npm run dev:desktop:watch",
    "start:desktop": "cd desktop && npm run start",
    "build:desktop": "cd desktop && npm run build:desktop",
    "build:desktop:dir": "cd desktop && npm run build:desktop:dir"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "browser-image-compression": "^2.0.2",
    "concurrently": "^9.2.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.33.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.8.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.183.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^1.3.1",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.3.1",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.7.0",
    "http-proxy": "^1.18.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^1.3.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "overrides": {
    "@anthropic-ai/sdk": "0.82.0",
    "openclaw": "2026.4.1",
    "socket.io-parser": "4.2.6",
    "path-to-regexp": "0.1.13"
  }
}
