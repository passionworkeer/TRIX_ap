# ============================================
# 🤖 Clawbot Gateway 配置
# ============================================
# WebSocket connection to Clawbot Gateway
#
# 🔧 请根据你的连接模式选择以下配置之一：
#
# 1️⃣ Tailscale 内网模式（推荐 - 更稳定）
#    获取 Tailscale IP: 运行 `tailscale ip`
#    将下面的 YOUR_TAILSCALE_IP 替换为实际 IP（如 100.64.0.1）
#
# 2️⃣ ngrok 公网模式（备用）
#    需要 ngrok 运行
#
# 3️⃣ 局域网模式（本地开发）
#    仅限同一网络内使用
# ============================================

# Tailscale 内网模式（推荐）
# ✅ Tailscale IP 已配置
VITE_PC_WEBSOCKET_URL=ws://100.110.229.48:18789
VITE_PC_WEBSOCKET_URL_MOBILE=ws://100.110.229.48:18789
VITE_PC_AUTH_TOKEN=f5a90456ca2531d1d227c95bba997726c5f139bcb5b798d6

# Gateway 配对配置
VITE_CLAWBOT_GATEWAY_URL=ws://100.110.229.48:18789
VITE_CLAWBOT_GATEWAY_TOKEN=f5a90456ca2531d1d227c95bba997726c5f139bcb5b798d6

